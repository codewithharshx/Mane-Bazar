# ════════════════════════════════════════════════════════════════════════════
# MANE BAZAR — SERVER ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your local or production values
# ════════════════════════════════════════════════════════════════════════════

# ─── SERVER CORE ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE ───────────────────────────────────────────────────────────────
# In Development: Leave MONGO_URI blank and set MONGODB_MEMORY_SERVER=true
# In Production: Set MONGODB_MEMORY_SERVER=false and supply your MongoDB Atlas URI
MONGO_URI=
MONGODB_MEMORY_SERVER=true

# ─── JWT AUTHENTICATION (⚠️ CHANGE IN PRODUCTION - Min 32 chars) ───────────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ─── CLIENT & CORS ──────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_WHITELIST=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ─── GOOGLE OAUTH 2.0 ───────────────────────────────────────────────────────
# Obtain credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── RAZORPAY PAYMENT GATEWAY ───────────────────────────────────────────────
# Obtain keys and webhook secret from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── EMAIL SERVICE (SMTP / SENDGRID / GMAIL) ────────────────────────────────
# In local dev without SMTP, email notifications log to console automatically
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-smtp-app-password
EMAIL_FROM=noreply@manebazar.com

# ─── REDIS (FOR EMAIL QUEUE & CACHING) ──────────────────────────────────────
# Optional in dev; falls back to direct synchronous email dispatch if absent
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── WHATSAPP NOTIFICATIONS (TWILIO) ────────────────────────────────────────
# Optional; if not configured, WhatsApp notifications log to console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155552671
ADMIN_WHATSAPP_NUMBER=+910000000000

# ─── EMAIL OTP & VERIFICATION POLICY ────────────────────────────────────────
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_MAX_RETRIES_PER_HOUR=5
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60

# ─── PASSWORD RESET POLICY ──────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ─── RATE LIMITING (WINDOW IN MS, MAX REQUESTS) ─────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
VERIFY_EMAIL_RATE_LIMIT_WINDOW_MS=600000
VERIFY_EMAIL_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=10
RESEND_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
RESEND_VERIFICATION_RATE_LIMIT_MAX=5
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=250
CHECKOUT_RATE_LIMIT_WINDOW_MS=600000
CHECKOUT_RATE_LIMIT_MAX=25

# ─── COOKIES & SECURITY ─────────────────────────────────────────────────────
# In production, set COOKIE_SECURE=true and COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ─── DEFAULT ADMIN SEED CONFIGURATION ───────────────────────────────────────
ADMIN_EMAIL=admin@manebazar.com
