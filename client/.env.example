# ════════════════════════════════════════════════════════════════════════════
# MANE BAZAR — CLIENT ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local frontend development
# ════════════════════════════════════════════════════════════════════════════

# ─── BACKEND API URL ────────────────────────────────────────────────────────
# Base URL of the running backend Express API server
VITE_API_URL=http://localhost:5000/api

# ─── RAZORPAY PAYMENT ───────────────────────────────────────────────────────
# Razorpay Publishable Key ID for Checkout Modal
# Obtain from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# ─── GOOGLE OAUTH ───────────────────────────────────────────────────────────
# Google OAuth 2.0 Client ID for Frontend Login Button
# Obtain from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
