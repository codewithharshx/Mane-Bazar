# ════════════════════════════════════════════════════════════════════════════
# MANE BAZAR — UNIFIED REPOSITORY ENVIRONMENT REFERENCE
# For actual runtime setup:
#   Frontend variables belong in: client/.env.local
#   Backend variables belong in:  server/.env
# See docs/ENVIRONMENT.md for exhaustive variable descriptions and production guidelines.
# ════════════════════════════════════════════════════════════════════════════

# ─── FRONTEND (client/.env.local) ───────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── BACKEND (server/.env) ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGO_URI=
MONGODB_MEMORY_SERVER=true
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
CLIENT_URL=http://localhost:5173
CORS_WHITELIST=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-smtp-app-password
EMAIL_FROM=noreply@manebazar.com
REDIS_URL=redis://127.0.0.1:6379
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155552671
ADMIN_WHATSAPP_NUMBER=+910000000000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ADMIN_EMAIL=admin@manebazar.com
