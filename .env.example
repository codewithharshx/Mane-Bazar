# ==============================================================================
# MANE BAZAR — UNIFIED REPOSITORY ENVIRONMENT REFERENCE
# ==============================================================================
# For actual runtime execution:
#   Backend API variables belong in:      apps/backend/.env
#   Database Prisma variables belong in:  packages/database/.env
#   Frontend Web App variables belong in: apps/frontend/.env
#
# See docs/ENVIRONMENT.md for exhaustive variable descriptions and security policies.
# ==============================================================================

# ─── DATABASE (PostgreSQL via Prisma ORM) ──────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL=postgresql://postgres:password@localhost:5432/mane_bazar?schema=public

# ─── BACKEND API (apps/backend/.env) ──────────────────────────────────────────
PORT=4000
NODE_ENV=development

# JWT Authentication (generate 32+ char random strings)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# CORS & Client Integration
CLIENT_URL=http://localhost:5173
CORS_WHITELIST=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM=noreply@manebazar.com
ADMIN_EMAIL=admin@manebazar.com

# Redis / Queue (Optional in dev, recommended in production)
REDIS_URL=redis://127.0.0.1:6379

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=250
CHECKOUT_RATE_LIMIT_WINDOW_MS=600000
CHECKOUT_RATE_LIMIT_MAX=25

# ─── FRONTEND WEB APP (apps/frontend/.env) ────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
