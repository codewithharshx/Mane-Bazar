{
  "name": "mane-bazar-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade grocery e-commerce monorepo platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=apps/backend run dev",
    "dev:frontend": "npm --workspace=apps/frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:shared": "npm --workspace=packages/shared run build",
    "build:database": "npm --workspace=packages/database run build",
    "build:backend": "npm --workspace=apps/backend run build",
    "build:frontend": "npm --workspace=apps/frontend run build",
    "build": "npm run build:shared && npm run build:database && npm run build:backend && npm run build:frontend",
    "db:migrate": "npm --workspace=packages/database run prisma:migrate",
    "db:seed": "npm --workspace=packages/database run seed",
    "db:studio": "npm --workspace=packages/database run prisma:studio",
    "db:generate": "npm --workspace=packages/database run prisma:generate",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^11.6.0",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "secretlint": "^11.6.0",
    "typescript": "^5.4.5"
  }
}
